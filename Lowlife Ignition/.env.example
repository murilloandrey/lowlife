# Public Shopify Storefront API credentials.
# Domain format: your-store.myshopify.com (no protocol or path).
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Staff hub destinations. Keep the full URLs here so ShopTickets can provide
# its store-specific secure scanner URL after installation.
VITE_SHOPIFY_ADMIN_URL=https://admin.shopify.com/store/your-store-handle
VITE_SHOPTICKETS_SCANNER_URL=https://shoptickets.net/

# Server-only newsletter integration. Never prefix this token with VITE_.
# Requires a Shopify custom app with the Admin API `write_customers` scope
# and protected customer data access. Defaults to VITE_SHOPIFY_DOMAIN.
SHOPIFY_ADMIN_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
