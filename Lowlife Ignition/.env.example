# Required in Vercel Preview and Production. Local builds may leave these blank.
# Public Shopify Storefront API credentials.
# Domain format: your-store.myshopify.com (no protocol or path).
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# VITE_SHOPIFY_ADMIN_URL is required in Vercel and rejects the placeholder.
# Staff hub destinations. Keep the full URLs here so ShopTickets can provide
# its store-specific secure scanner URL after installation.
VITE_SHOPIFY_ADMIN_URL=https://admin.shopify.com/store/lowlife-8113
VITE_SHOPTICKETS_SCANNER_URL=https://shoptickets.net/

# SHOPIFY_ADMIN_ACCESS_TOKEN is required in Vercel. Never prefix it with VITE_.
# Server-only newsletter integration.
# Requires a Shopify custom app with the Admin API `write_customers` scope
# and protected customer data access. Defaults to VITE_SHOPIFY_DOMAIN.
SHOPIFY_ADMIN_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Sentry runtime DSN. Safe to expose to the browser; paste the React project's
# DSN here and set the same variable in Vercel Preview and Production.
VITE_SENTRY_DSN=

# Build-only source-map upload settings. SENTRY_AUTH_TOKEN is secret.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
